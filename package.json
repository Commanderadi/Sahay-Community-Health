{
  "name": "sahay",
  "version": "1.0.0",
  "description": "Community Health Clinic Directory",
  "scripts": {
    "install-all": "npm install && npm --prefix client install && npm --prefix server install",
    "dev": "concurrently -n server,client -c blue,green \"npm --prefix server run dev\" \"npm --prefix client start\"",
    "start": "npm --prefix server start",
    "client": "npm --prefix client start",
    "server": "npm --prefix server start",
    "build": "npm --prefix client run build",
    "test": "npm --prefix client test -- --watchAll=false"
  },
  "keywords": [
    "health",
    "clinic",
    "directory",
    "react",
    "nodejs",
    "mongodb"
  ],
  "author": "Aditya Singh",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
