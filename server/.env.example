# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sahay?retryWrites=true&w=majority

# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Port the API listens on (Render sets this automatically; 5000 for local dev)
PORT=5000

# Comma-separated list of allowed browser origins for CORS, e.g.
# ALLOWED_ORIGINS=https://sahaycommunity.netlify.app
ALLOWED_ORIGINS=
